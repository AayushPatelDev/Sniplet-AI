# ─────────────────────────────────────────────────────────────────────────────
# Sniplet AI — local configuration
#
# Copy this file to `.env` and fill in ONE (or more) provider keys.
# `.env` is gitignored. Your keys stay on this machine and are only ever sent
# to the provider you select.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Which provider to use by default when the UI hasn't overridden it.
# One of: openai | anthropic | google | compatible
DEFAULT_PROVIDER=openai

# Optional: pin a default model. Leave blank to use the provider's default.
DEFAULT_MODEL=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Google (Gemini) ──────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Any OpenAI-compatible endpoint ───────────────────────────────────────────
# Works with OpenRouter, DeepSeek, Groq, Together, Fireworks, Ollama, LM Studio…
# Examples:
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1   (COMPATIBLE_API_KEY=ollama)
#   LM Studio   http://localhost:1234/v1    (COMPATIBLE_API_KEY=lm-studio)
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# Allow the browser to send its own API key with each request, instead of
# using the keys above. Handy if you'd rather not keep keys in a file.
# Keep this on only for local use — never expose this server to the internet.
ALLOW_CLIENT_KEYS=true
